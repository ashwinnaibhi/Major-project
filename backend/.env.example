# =============================================================================
# HaemoPulse Blood Bank Backend Environment Configuration Example
# =============================================================================
# Copy this file to `backend/.env` and update with your actual configuration.
# Never commit `.env` containing real passwords, secret keys, or credentials to Git.

# -----------------------------------------------------------------------------
# Frontend Application URL (used to generate single-use email verification links)
# -----------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# JWT Authentication Secret
# Must be a secure random string of 32 or more characters.
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS

# -----------------------------------------------------------------------------
# Real Gmail SMTP Configuration (for Donor Account Email Verification)
# -----------------------------------------------------------------------------
# Instructions for Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password at:
#    https://myaccount.google.com/apppasswords
#    (Select App name: "HaemoPulse Blood Bank")
# 3. Enter your Gmail address and 16-character App Password below (without spaces):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_MAIL_FROM=HaemoPulse Blood Bank <your_email@example.com>

# -----------------------------------------------------------------------------
# Brevo API Configuration (for Transactional Emergency Notifications)
# -----------------------------------------------------------------------------
# Server-side only; never expose through frontend VITE_* variables.
# Create and verify a sender in your Brevo account before production delivery.
BREVO_API_KEY=your_brevo_api_key_placeholder
MAIL_FROM=your_verified_sender@example.com


# -----------------------------------------------------------------------------
# Safety & Testing Controls
# -----------------------------------------------------------------------------
# Set to 'false' to enable live email delivery via Gmail SMTP.
# While 'true', live outgoing network messages are blocked for safety.
HAEMOPULSE_DISABLE_EXTERNAL_MESSAGES=true

# Optional fail-closed guard: 'mock' (default) or 'live'
HAEMOPULSE_EMAIL_MODE=mock
HAEMOPULSE_ALLOW_LIVE_EMAIL=false
