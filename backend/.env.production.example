# ==============================================================================
# HaemoPulse Production Backend Environment Variables Template
# Copy these keys into your hosting provider's dashboard (e.g. Render / Koyeb).
# NEVER COMMIT REAL SECRETS OR PASSWORDS TO GIT.
# ==============================================================================

# 1. Frontend & Routing Configuration
# Public HTTPS domain where your frontend is deployed (Cloudflare Pages / Vercel).
# All email verification links will use this domain.
FRONTEND_BASE_URL=https://haemopulse.pages.dev

# Allowed CORS origins (comma-separated list of your frontend URLs)
ALLOWED_ORIGINS=https://haemopulse.pages.dev,https://haemopulse.vercel.app

# Secure 64-character random key for JWT signing
JWT_SECRET=your_generated_64_character_jwt_secret_key

# 2. Database Configuration (Persistent Neon PostgreSQL)
# Required for production because Render web services have ephemeral filesystems.
# Get free PostgreSQL URI at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Email Delivery Configuration (HTTPS API Architecture)
# IMPORTANT: Render Free Tier strictly blocks outbound SMTP ports 25, 465, and 587.
# Therefore, use 'brevo' or 'resend' to send emails over HTTPS Port 443!
EMAIL_DELIVERY_METHOD=brevo
HAEMOPULSE_DISABLE_EXTERNAL_MESSAGES=false

# If using Brevo (300 free emails/day):
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=ashwinkumarnsrao@gmail.com
MAIL_FROM_NAME=HaemoPulse Blood Bank

# If using Resend (100 free emails/day):
# EMAIL_DELIVERY_METHOD=resend
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM=onboarding@resend.dev

# 4. Optional SMTP (For local development or paid hosts where ports 587/465 are open)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ashwinkumarnsrao@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_MAIL_FROM=HaemoPulse Blood Bank <ashwinkumarnsrao@gmail.com>
