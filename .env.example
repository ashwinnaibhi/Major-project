# ==========================================
# HaemoPulse Mail & Server Configuration
# ==========================================

# Frontend URL (for email verification links)
# Production: https://haemopulse.ashwinkumarnsrao.workers.dev
# Local Development: http://localhost:3000
FRONTEND_URL=https://haemopulse.ashwinkumarnsrao.workers.dev
FRONTEND_BASE_URL=https://haemopulse.ashwinkumarnsrao.workers.dev

# JWT Authentication Secret
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS

# SMTP Configuration (For Gmail, use an App Password with 2-Step Verification)
# Example Gmail settings:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_gmail_app_password_placeholder
SMTP_MAIL_FROM=HaemoPulse Blood Bank <your_email@example.com>

# Brevo transactional API for emergency notifications (server-side only; never use VITE_ variables).
# Create/verify a sender in Brevo before production use. Keep placeholders here only.
BREVO_API_KEY=your_brevo_api_key_placeholder
# Use a sender address verified in Brevo; it is separate from the legacy SMTP verification sender.
MAIL_FROM=verified_sender@example.com
MAIL_FROM_NAME=HaemoPulse Blood Bank
# Configure this bearer token in the Brevo transactional webhook settings as supported by Brevo.
BREVO_WEBHOOK_BEARER_TOKEN=replace_with_a_long_random_webhook_token

# Keep ALL real external email delivery disabled during implementation/testing.
# Change to false only after provider setup and separate explicit approval for a one-recipient test.
HAEMOPULSE_DISABLE_EXTERNAL_MESSAGES=false

# Nearest eligible donor matching for emergency requests (kilometres).
HAEMOPULSE_EMERGENCY_RADIUS_KM=50
HAEMOPULSE_MAX_NEAREST_DONORS=10
#FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://192.168.1.37:3000
