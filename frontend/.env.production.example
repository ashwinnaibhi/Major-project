# ==============================================================================
# HaemoPulse Production Frontend Environment Variables Template
# Set these in your frontend hosting dashboard (Cloudflare Pages / Vercel).
# ==============================================================================

# Public HTTPS URL of the deployed backend API (e.g. Render / Koyeb)
VITE_API_BASE_URL=https://haemopulse-backend.onrender.com
VITE_API_URL=https://haemopulse-backend.onrender.com

# Unified ML predictor runs inside the backend API
VITE_ML_SERVICE_URL=https://haemopulse-backend.onrender.com
VITE_ML_API_BASE_URL=https://haemopulse-backend.onrender.com
